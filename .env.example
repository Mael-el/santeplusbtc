# ============================================================================
# SANTÉ+ BÉNIN - CONFIGURATION D'ENVIRONNEMENT
# ============================================================================

# SERVEUR
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_PORT=3000

# BASE DE DONNÉES POSTGRESQL (obligatoire en production)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=santeplus
POSTGRES_USER=santeplus
POSTGRES_PASSWORD=change-this-postgres-password

# MONGODB (obligatoire en production)
MONGO_ROOT_USERNAME=change-this-mongo-admin
MONGO_ROOT_PASSWORD=change-this-mongo-password
MONGODB_URI=mongodb://change-this-mongo-admin:change-this-mongo-password@mongodb:27017/santeplus?authSource=admin

# AUTHENTIFICATION & SECRETS JWT
JWT_SECRET=generate-a-long-random-access-secret
JWT_REFRESH_SECRET=generate-a-long-random-refresh-secret

# Chiffrement des dossiers médicaux: 32 octets en hexadécimal (64 caractères)
ENCRYPTION_KEY=generate-64-hex-characters-for-aes-256

# IPFS/Pinata: obligatoires en production pour l’archivage chiffré
PINATA_API_KEY=
PINATA_SECRET_API_KEY=
PINATA_GATEWAY_URL=https://gateway.pinata.cloud/ipfs/

# COMPTES INITIAUX DU SYSTÈME (SEED SÉCURISÉ)
INITIAL_ADMIN_PASSWORD=generate-a-strong-admin-password
INITIAL_DIRECTOR_PASSWORD=generate-a-strong-director-password
INITIAL_DOCTOR_PASSWORD=generate-a-strong-doctor-password

# CORS: liste séparée par des virgules, sans espace obligatoire
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://0.0.0.0:3000,http://192.168.228.4:3000

# FRONTEND
VITE_API_URL=/api

# PAIEMENT LIGHTNING
LIGHTNING_PROVIDER=lnbits
LNBITS_URL=http://localhost:5000
LNBITS_API_KEY=
# Pour Breez/Izichange REST
LIGHTNING_API_URL=
LIGHTNING_API_KEY=

# EMAIL SMTP (pour la réinitialisation du mot de passe par email)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@santeplus.bj

# ASSISTANT IA MÉDICAL (Optionnel - clé Gemini API pour triage IA)
GEMINI_API_KEY=""

# PAIEMENTS MOBILE MONEY (Optionnel - mode Sandbox)
FIAT_PROVIDER=fedapay
FIAT_API_URL=https://api.fedapay.com/v1/transactions
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_WEBHOOK_SECRET=
IZICHANGE_API_KEY=
IZICHANGE_MERCHANT_ID=
MTN_MONEY_API_KEY=""
MOOV_MONEY_API_KEY=""

# AGREGATEUR MOBILE MONEY PRINCIPAL (choix: cinetpay | kkiapay | feexpay | fedapay | sandbox)
AGGREGATOR_CHOICE=cinetpay
CELTIIS_SUPPORT=true

# CINETPAY (agrégateur officiel Bénin - MTN + Moov)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_WEBHOOK_SECRET=
CINETPAY_BASE_URL=https://api-checkout.cinetpay.com/v2/payment

# FEEXPAY
FEEXPAY_API_KEY=
FEEXPAY_WEBHOOK_SECRET=
FEEXPAY_BASE_URL=https://api.feexpay.com/api/v1/payment

# PUBLIC WEBHOOK URL (à remplir en production, ex: https://api.santeplus.bj)
PUBLIC_WEBHOOK_BASE_URL=
